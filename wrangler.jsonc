    "SUPABASE_KEY": "sb_publishable_-xFSOAUFZsfTi82n-5FY4w_O5ep9DB2",
    "EEUM_SSO_JWK_X": "",
    "EEUM_SSO_ADMIN": "dal106@admin.unsong.bid",
    "VAPID_PUBLIC": "",
    "STORAGE_DRIVER": "supabase",
    "NAS_WEBDAV_URL": "https://nas.unsong.bid/unsongbi",
    "NAS_WEBDAV_USER": "unsongb"
  },
  "build": {
    "command": "node tools/db-migrate.cjs || true; node build.cjs"
  }
}
